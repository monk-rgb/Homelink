    "var_be02a614c172": {
      "type": "variant",
      "label": "Floating Pill Nav — Midnight Dynamic Island",
      "parentId": null,
      "themeId": null,
      "rect": {
        "x": 1380,
        "y": 0,
        "w": 1280,
        "h": 800
      },
      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,600;9..144,700&family=Outfit:wght@300;400;500;600;700&display=swap');\n\n  :root {\n    --ink: #070709;\n    --ink-soft: #101116;\n    --paper: #f4f1ea;\n    --muted: #a7a4a0;\n    --line: rgba(255,255,255,.13);\n    --gold: #dfb94c;\n    --gold-soft: #f4d982;\n    --blue: #4c9cff;\n    --violet: #8b69ff;\n  }\n\n  .estimate-page {\n    min-height: 100%;\n    overflow: hidden;\n    position: relative;\n    color: var(--paper);\n    background:\n      radial-gradient(circle at 75% 4%, rgba(82, 105, 255, .17), transparent 26rem),\n      radial-gradient(circle at 25% 13%, rgba(224, 174, 52, .10), transparent 21rem),\n      var(--ink);\n    font-family: 'Outfit', system-ui, sans-serif;\n  }\n\n  .estimate-page::before {\n    content: '';\n    position: absolute;\n    inset: 0;\n    pointer-events: none;\n    opacity: .18;\n    background-image: url(\"data:image/svg+xml,%3Csvg viewBox='0 0 180 180' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='.8' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='.36'/%3E%3C/svg%3E\");\n    mix-blend-mode: soft-light;\n  }\n\n  .page-shell { position: relative; z-index: 1; }\n\n  .aurora {\n    position: absolute;\n    top: -80px;\n    left: 50%;\n    width: 600px;\n    height: 300px;\n    transform: translateX(-50%);\n    border-radius: 999px;\n    pointer-events: none;\n    filter: blur(38px);\n    opacity: .7;\n    background: radial-gradient(ellipse at center, rgba(76,156,255,.28) 0%, rgba(139,105,255,.17) 38%, rgba(222,182,49,.08) 62%, transparent 78%);\n  }\n\n  .island-nav {\n    position: fixed;\n    top: 16px;\n    left: 50%;\n    z-index: 30;\n    display: flex;\n    align-items: center;\n    width: min(1050px, calc(100% - 32px));\n    min-height: 58px;\n    padding: 8px 12px 8px 16px;\n    transform: translateX(-50%);\n    border: 1px solid rgba(255,255,255,.16);\n    border-radius: 999px;\n    background: rgba(8, 8, 11, .92);\n    box-shadow:\n      0 24px 55px rgba(0,0,0,.32),\n      0 5px 17px rgba(0,0,0,.38),\n      inset 0 1px 0 rgba(255,255,255,.12),\n      0 0 0 1px rgba(126, 104, 255, .08),\n      0 0 42px rgba(83, 91, 255, .10);\n    backdrop-filter: blur(22px) saturate(140%);\n  }\n\n  .nav-brand,\n  .nav-center,\n  .nav-actions { display: flex; align-items: center; }\n  .nav-brand { flex: 0 0 auto; gap: 9px; min-width: 184px; color: #fff; }\n  .nav-brand strong { font-size: 16px; font-weight: 700; letter-spacing: -.035em; }\n  .nav-brand strong span { color: var(--gold-soft); font-weight: 500; }\n\n  .app-icon {\n    position: relative;\n    display: grid;\n    width: 34px;\n    height: 34px;\n    place-items: center;\n    overflow: hidden;\n    border: 1px solid rgba(255,255,255,.33);\n    border-radius: 11px;\n    color: #fff;\n    font-family: 'Fraunces', serif;\n    font-size: 17px;\n    font-weight: 700;\n    background: linear-gradient(145deg, #9cd3ff 0%, #4e91ee 28%, #2a4fb6 61%, #d8aa38 100%);\n    box-shadow:\n      inset 2px 2px 5px rgba(255,255,255,.42),\n      inset -4px -5px 8px rgba(4, 13, 57, .42),\n      0 5px 12px rgba(49, 111, 215, .30);\n  }\n  .app-icon::before {\n    content: '';\n    position: absolute;\n    top: 4px;\n    left: 6px;\n    width: 16px;\n    height: 7px;\n    border-radius: 999px;\n    background: rgba(255,255,255,.52);\n    transform: rotate(-22deg);\n    filter: blur(1px);\n  }\n  .app-icon::after {\n    content: '';\n    position: absolute;\n    right: 4px;\n    bottom: 4px;\n    width: 7px;\n    height: 7px;\n    border-radius: 50%;\n    background: var(--gold-soft);\n    box-shadow: 0 0 9px rgba(244,217,130,.9);\n  }\n\n  .nav-center { flex: 1 1 auto; justify-content: center; gap: 26px; }\n  .nav-center a {\n    color: rgba(255,255,255,.65);\n    font-size: 12px;\n    font-weight: 400;\n    letter-spacing: -.01em;\n    transition: color .2s ease, opacity .2s ease;\n    white-space: nowrap;\n  }\n  .nav-center a:hover { color: #fff; opacity: 1; }\n\n  .nav-actions { flex: 0 0 auto; gap: 9px; }\n  .start-button {\n    display: inline-flex;\n    align-items: center;\n    gap: 8px;\n    padding: 10px 15px;\n    border-radius: 999px;\n    color: #101114;\n    background: #fff;\n    box-shadow: 0 4px 16px rgba(255,255,255,.10), inset 0 -1px 0 rgba(0,0,0,.12);\n    font-size: 12px;\n    font-weight: 700;\n    letter-spacing: -.01em;\n    white-space: nowrap;\n  }\n  .start-button svg { width: 14px; height: 14px; stroke-width: 2.4; }\n  .theme-button {\n    display: grid;\n    width: 32px;\n    height: 32px;\n    place-items: center;\n    border: 1px solid rgba(255,255,255,.12);\n    border-radius: 999px;\n    color: rgba(255,255,255,.57);\n    background: rgba(255,255,255,.06);\n  }\n  .theme-button svg { width: 15px; height: 15px; stroke-width: 1.7; }\n\n  .hero {\n    display: grid;\n    grid-template-columns: minmax(0, .92fr) minmax(0, 1.08fr);\n    align-items: center;\n    gap: 72px;\n    width: min(1160px, calc(100% - 112px));\n    min-height: 650px;\n    margin: 0 auto;\n    padding: 142px 0 82px;\n  }\n  .eyebrow { color: var(--gold-soft); font-size: 10px; font-weight: 600; letter-spacing: .2em; text-transform: uppercase; }\n  .hero h1 {\n    max-width: 550px;\n    margin: 17px 0 19px;\n    color: #f7f5ef;\n    font-family: 'Fraunces', Georgia, serif;\n    font-size: clamp(54px, 6.1vw, 82px);\n    font-weight: 600;\n    letter-spacing: -.06em;\n    line-height: .96;\n  }\n  .hero h1 em { color: var(--gold-soft); font-style: italic; font-weight: 500; }\n  .hero-copy p { max-width: 475px; margin: 0; color: #aeaba8; font-size: 15px; line-height: 1.65; }\n  .hero-actions { display: flex; align-items: center; gap: 21px; margin-top: 32px; }\n  .hero-cta {\n    display: inline-flex;\n    align-items: center;\n    gap: 9px;\n    padding: 13px 19px;\n    border-radius: 8px;\n    color: #17130a;\n    background: var(--gold);\n    box-shadow: 0 12px 26px rgba(222,182,49,.14);\n    font-size: 13px;\n    font-weight: 700;\n  }\n  .hero-cta svg { width: 15px; height: 15px; }\n  .text-link { color: #e9dfc1; font-size: 13px; font-weight: 600; }\n\n  .hero-art {\n    position: relative;\n    height: 438px;\n    overflow: hidden;\n    border: 1px solid rgba(255,255,255,.14);\n    border-radius: 24px;\n    background: #171819;\n    box-shadow: 0 24px 60px rgba(0,0,0,.24);\n  }\n  .hero-art::after { content: ''; position: absolute; inset: 0; background: linear-gradient(180deg, rgba(9,9,12,.02), rgba(9,9,12,.5)); pointer-events: none; }\n  .terraced-photo { width: 100%; height: 100%; object-fit: cover; opacity: .78; filter: saturate(.78) contrast(1.05); }\n  .arch { position: absolute; left: 14%; bottom: -15%; width: 54%; height: 74%; border: 1px solid rgba(244,217,130,.72); border-bottom: 0; border-radius: 340px 340px 0 0; opacity: .78; }\n  .estimate-float { position: absolute; top: 24px; right: 24px; z-index: 2; min-width: 194px; padding: 15px 17px; border: 1px solid rgba(255,255,255,.25); border-radius: 12px; background: rgba(13,13,15,.75); box-shadow: 0 10px 24px rgba(0,0,0,.25); backdrop-filter: blur(14px); }\n  .estimate-float span, .estimate-float small { display: block; color: #c4c0b5; font-size: 9px; letter-spacing: .14em; text-transform: uppercase; }\n  .estimate-float strong { display: block; margin: 5px 0 3px; color: #fff; font-family: 'Fraunces', serif; font-size: 31px; font-weight: 600; letter-spacing: -.05em; }\n  .estimate-float small { color: var(--gold-soft); font-size: 9px; letter-spacing: 0; text-transform: none; }\n\n  .stats { display: grid; grid-template-columns: repeat(4, 1fr); width: min(1160px, calc(100% - 112px)); margin: 0 auto; border-top: 1px solid rgba(255,255,255,.15); border-bottom: 1px solid rgba(255,255,255,.15); }\n  .stats div { display: flex; flex-direction: column; gap: 3px; padding: 22px 24px 23px 0; border-right: 1px solid rgba(255,255,255,.12); }\n  .stats div:not(:first-child) { padding-left: 24px; }\n  .stats div:last-child { border-right: 0; }\n  .stats strong { color: var(--gold-soft); font-family: 'Fraunces', serif; font-size: 26px; font-weight: 500; }\n  .stats span { color: #92908d; font-size: 11px; }\n\n  .section { width: min(1160px, calc(100% - 112px)); margin: 0 auto; padding: 90px 0; }\n  .section-head { display: flex; align-items: end; justify-content: space-between; gap: 40px; margin-bottom: 35px; }\n  .section-head h2 { margin: 12px 0 0; color: #f5f2eb; font-family: 'Fraunces', serif; font-size: 43px; font-weight: 500; letter-spacing: -.05em; line-height: 1.02; }\n  .section-head p { max-width: 340px; margin: 0; color: #96938e; font-size: 13px; line-height: 1.6; }\n  .feature-grid { display: grid; grid-template-columns: repeat(3, 1fr); border-top: 1px solid rgba(255,255,255,.14); border-bottom: 1px solid rgba(255,255,255,.14); }\n  .feature-grid article { min-height: 210px; padding: 27px 30px 27px 0; border-right: 1px solid rgba(255,255,255,.12); }\n  .feature-grid article + article { padding-left: 30px; }\n  .feature-grid article:last-child { border-right: 0; }\n  .feature-grid article > span { color: var(--gold); font-size: 11px; font-weight: 600; }\n  .feature-grid h3, .steps h3 { margin: 13px 0 8px; color: #f1eee7; font-family: 'Fraunces', serif; font-size: 26px; font-weight: 500; letter-spacing: -.03em; }\n  .feature-grid p, .steps p { margin: 0; color: #96938e; font-size: 13px; line-height: 1.65; }\n\n  .dark-panel { width: 100%; background: #111113; border-top: 1px solid rgba(255,255,255,.08); border-bottom: 1px solid rgba(255,255,255,.08); }\n  .dark-panel .section { padding-top: 80px; padding-bottom: 86px; }\n  .steps { display: grid; grid-template-columns: repeat(3, 1fr); gap: 35px; }\n  .steps b { color: var(--gold-soft); font-size: 11px; font-weight: 600; letter-spacing: .12em; }\n\n  .cta { display: flex; align-items: center; justify-content: space-between; gap: 30px; width: min(1160px, calc(100% - 112px)); margin: 66px auto 76px; padding: 39px 42px; border-radius: 18px; color: #18140a; background: linear-gradient(105deg, #d6a92f, #eed273 72%, #d8b642); box-shadow: 0 18px 42px rgba(214,169,47,.13); }\n  .cta .eyebrow { color: #584410; }\n  .cta h2 { margin: 12px 0 0; font-family: 'Fraunces', serif; font-size: 39px; font-weight: 600; letter-spacing: -.05em; line-height: 1.02; }\n  .cta .hero-cta { color: #f4f1ea; background: #151518; box-shadow: none; }\n  footer { display: flex; justify-content: space-between; width: min(1160px, calc(100% - 112px)); margin: 0 auto; padding: 0 0 32px; color: #73716e; font-size: 11px; }\n\n  @media (max-width: 820px) {\n    .island-nav { width: calc(100% - 24px); padding-left: 12px; }\n    .nav-brand { min-width: auto; }\n    .nav-center { gap: 14px; }\n    .hero, .stats, .section, .cta, footer { width: calc(100% - 48px); }\n    .hero { grid-template-columns: 1fr; gap: 44px; padding-top: 128px; }\n    .hero-art { height: 360px; }\n  }\n\n  @media (max-width: 620px) {\n    .island-nav { min-height: 54px; top: 12px; }\n    .nav-center { display: none; }\n    .nav-brand { flex: 1 1 auto; }\n    .nav-brand strong { font-size: 15px; }\n    .app-icon { width: 31px; height: 31px; border-radius: 10px; font-size: 15px; }\n    .theme-button { width: 29px; height: 29px; }\n    .start-button { padding: 9px 12px; }\n    .start-button svg { width: 13px; height: 13px; }\n    .hero, .stats, .section, .cta, footer { width: calc(100% - 32px); }\n    .hero { min-height: 0; padding-top: 108px; padding-bottom: 58px; }\n    .hero h1 { font-size: 55px; }\n    .hero-actions { align-items: flex-start; flex-direction: column; gap: 16px; }\n    .hero-art { height: 300px; border-radius: 17px; }\n    .estimate-float { top: 16px; right: 16px; min-width: 164px; }\n    .stats { grid-template-columns: repeat(2, 1fr); }\n    .stats div { padding: 16px 12px; }\n    .stats div:not(:first-child) { padding-left: 12px; }\n    .stats div:nth-child(2) { border-right: 0; }\n    .section { padding: 63px 0; }\n    .section-head { align-items: flex-start; flex-direction: column; gap: 20px; }\n    .section-head h2 { font-size: 37px; }\n    .feature-grid, .steps { grid-template-columns: 1fr; }\n    .feature-grid article, .feature-grid article + article { min-height: 0; padding: 22px 0; border-right: 0; border-bottom: 1px solid rgba(255,255,255,.12); }\n    .feature-grid article:last-child { border-bottom: 0; }\n    .cta { align-items: flex-start; flex-direction: column; margin-top: 38px; padding: 28px 24px; }\n    .cta h2 { font-size: 34px; }\n    footer { align-items: flex-start; flex-direction: column; gap: 8px; }\n  }\n</style>\n<div class=\"estimate-page\" data-kid=\"1\" data-name=\"page layout container\">\n    <div class=\"aurora\" data-kid=\"1-1\" data-name=\"aurora gradient background\">\n    </div>\n    <header aria-label=\"Primary navigation\" class=\"island-nav\" data-kid=\"1-2\" data-name=\"primary navigation bar\">\n        <a aria-label=\"EstiMate home\" class=\"nav-brand\" data-kid=\"1-2-1\" data-name=\"brand identity link\" href=\"#top\">\n            <span aria-hidden=\"true\" class=\"app-icon\" data-kid=\"1-2-1-1\" data-name=\"app icon\">\n                E\n            </span>\n            <strong data-kid=\"1-2-1-2\" data-name=\"brand name text\">\n                EstiMate\n                <span data-kid=\"1-2-1-2-1\" data-name=\"brand modifier text\">\n                    AI\n                </span>\n            </strong>\n        </a>\n        <nav aria-label=\"Product navigation\" class=\"nav-center\" data-kid=\"1-2-2\" data-name=\"navigation menu links\">\n            <a data-kid=\"1-2-2-1\" data-name=\"prediction link\" href=\"#prediction\">\n                Prediction\n            </a>\n            <a data-kid=\"1-2-2-2\" data-name=\"propkonet link\" href=\"#propkonet\">\n                PropkoNet\n            </a>\n            <a data-kid=\"1-2-2-3\" data-name=\"about link\" href=\"#about\">\n                About\n            </a>\n            <a data-kid=\"1-2-2-4\" data-name=\"manager link\" href=\"#manager\">\n                Manager\n            </a>\n        </nav>\n        <div class=\"nav-actions\" data-kid=\"1-2-3\" data-name=\"navigation action buttons\">\n            <a class=\"start-button\" data-kid=\"1-2-3-1\" data-name=\"get started button\" href=\"#start\">\n                <i aria-hidden=\"true\" data-kid=\"1-2-3-1-1\" data-lucide=\"house\" data-name=\"house icon\">\n                </i>\n                Get Started\n            </a>\n            <span aria-label=\"Theme mode\" class=\"theme-button\" data-kid=\"1-2-3-2\" data-name=\"theme toggle button\" role=\"img\">\n                <i aria-hidden=\"true\" data-kid=\"1-2-3-2-1\" data-lucide=\"sun-moon\" data-name=\"sun moon icon\">\n                </i>\n            </span>\n        </div>\n    </header>\n    <main class=\"page-shell\" data-kid=\"1-3\" data-name=\"main page content\" id=\"top\">\n        <section class=\"hero\" data-kid=\"1-3-1\" data-name=\"hero section\" id=\"prediction\">\n            <div class=\"hero-copy\" data-kid=\"1-3-1-1\" data-name=\"hero copy block\">\n                <div class=\"eyebrow\" data-kid=\"1-3-1-1-1\" data-name=\"hero eyebrow text\">\n                    Clearer Estimates\n                </div>\n                <h1 data-kid=\"1-3-1-1-2\" data-name=\"hero headline text\">\n                    Nigerian\n                    <br data-kid=\"1-3-1-1-2-1\" data-name=\"headline line break\"/>\n                    <em data-kid=\"1-3-1-1-2-2\" data-name=\"headline emphasized text\">\n                        Real estate Intelligence\n                    </em>\n                </h1>\n                <p data-kid=\"1-3-1-1-3\" data-name=\"hero description text\">\n                    Compare the details of a Nigerian property against the model's market patterns before you arrange a viewing, make an offer, or brief a valuer.\n                </p>\n                <div class=\"hero-actions\" data-kid=\"1-3-1-1-4\" data-name=\"hero action buttons\">\n                    <a class=\"hero-cta\" data-kid=\"1-3-1-1-4-1\" data-name=\"estimate call to action\" href=\"#start\">\n                        Estimate a property\n                        <i aria-hidden=\"true\" data-kid=\"1-3-1-1-4-1-1\" data-lucide=\"arrow-up-right\" data-name=\"arrow up right icon\">\n                        </i>\n                    </a>\n                    <a class=\"text-link\" data-kid=\"1-3-1-1-4-2\" data-name=\"review photo link\" href=\"#prediction\">\n                        Review a property photo\n                    </a>\n                </div>\n            </div>\n            <div aria-label=\"Modern terraced duplex exterior with AI estimate\" class=\"hero-art\" data-kid=\"1-3-1-2\" data-name=\"hero image container\">\n                <img alt=\"Modern terraced duplex exterior\" class=\"terraced-photo\" data-kid=\"1-3-1-2-1\" data-name=\"terraced property image\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/static/uploads/a9ef982aca674ff493ff629c98b517e4.jpg\"/>\n                <div class=\"arch\" data-kid=\"1-3-1-2-2\" data-name=\"arch decorative element\">\n                </div>\n                <div class=\"estimate-float\" data-kid=\"1-3-1-2-3\" data-name=\"estimate floating card\">\n                    <span data-kid=\"1-3-1-2-3-1\" data-name=\"ai estimate label\">\n                        AI ESTIMATE\n                    </span>\n                    <strong data-kid=\"1-3-1-2-3-2\" data-name=\"ai estimate value text\">\n                        ₦200M\n                    </strong>\n                    <small data-kid=\"1-3-1-2-3-3\" data-name=\"confidence range text\">\n                        Confidence range · ₦195M — ₦215M\n                    </small>\n                </div>\n            </div>\n        </section>\n        <section aria-label=\"Estimation workflow\" class=\"stats\" data-kid=\"1-3-2\" data-name=\"estimation workflow stats\">\n            <div data-kid=\"1-3-2-1\" data-name=\"workflow step one\">\n                <strong data-kid=\"1-3-2-1-1\" data-name=\"step one number\">\n                    01\n                </strong>\n                <span data-kid=\"1-3-2-1-2\" data-name=\"step one description\">\n                    Enter property details\n                </span>\n            </div>\n            <div data-kid=\"1-3-2-2\" data-name=\"workflow step two\">\n                <strong data-kid=\"1-3-2-2-1\" data-name=\"step two number\">\n                    02\n                </strong>\n                <span data-kid=\"1-3-2-2-2\" data-name=\"step two description\">\n                    Review the estimate range\n                </span>\n            </div>\n            <div data-kid=\"1-3-2-3\" data-name=\"workflow step three\">\n                <strong data-kid=\"1-3-2-3-1\" data-name=\"step three number\">\n                    03\n                </strong>\n                <span data-kid=\"1-3-2-3-2\" data-name=\"step three description\">\n                    Save property work in one place\n                </span>\n            </div>\n            <div data-kid=\"1-3-2-4\" data-name=\"workflow currency indicator\">\n                <strong data-kid=\"1-3-2-4-1\" data-name=\"currency code\">\n                    NGN\n                </strong>\n                <span data-kid=\"1-3-2-4-2\" data-name=\"currency description\">\n                    Prices shown in naira\n                </span>\n            </div>\n        </section>\n        <section class=\"section\" data-kid=\"1-3-3\" data-name=\"about section\" id=\"about\">\n            <div class=\"section-head\" data-kid=\"1-3-3-1\" data-name=\"about section header\">\n                <div data-kid=\"1-3-3-1-1\" data-name=\"about header copy\">\n                    <div class=\"eyebrow\" data-kid=\"1-3-3-1-1-1\" data-name=\"about eyebrow text\">\n                        A PRACTICAL STARTING POINT\n                    </div>\n                    <h2 data-kid=\"1-3-3-1-1-2\" data-name=\"about heading text\">\n                        Make the next\n                        <br data-kid=\"1-3-3-1-1-2-1\" data-name=\"heading line break\"/>\n                        property decision easier.\n                    </h2>\n                </div>\n                <p data-kid=\"1-3-3-1-2\" data-name=\"about subheadline text\">\n                    Built for buyers, sellers, agents and investors who want a sharper first estimate before a human valuation.\n                </p>\n            </div>\n            <div class=\"feature-grid\" data-kid=\"1-3-3-2\" data-name=\"features grid\">\n                <article data-kid=\"1-3-3-2-1\" data-name=\"feature data-led\">\n                    <span data-kid=\"1-3-3-2-1-1\" data-name=\"feature one number\">\n                        01\n                    </span>\n                    <h3 data-kid=\"1-3-3-2-1-2\" data-name=\"feature one heading\">\n                        Data-led\n                    </h3>\n                    <p data-kid=\"1-3-3-2-1-3\" data-name=\"feature one text\">\n                        Predictions learn patterns from Nigerian property records instead of relying on a generic global model.\n                    </p>\n                </article>\n                <article data-kid=\"1-3-3-2-2\" data-name=\"feature photo review\">\n                    <span data-kid=\"1-3-3-2-2-1\" data-name=\"feature two number\">\n                        02\n                    </span>\n                    <h3 data-kid=\"1-3-3-2-2-2\" data-name=\"feature two heading\">\n                        Photo review\n                    </h3>\n                    <p data-kid=\"1-3-3-2-2-3\" data-name=\"feature two text\">\n                        Upload a property image to record the visible finish, layout cues and likely property type alongside your own research.\n                    </p>\n                </article>\n                <article data-kid=\"1-3-3-2-3\" data-name=\"feature business\">\n                    <span data-kid=\"1-3-3-2-3-1\" data-name=\"feature three number\">\n                        03\n                    </span>\n                    <h3 data-kid=\"1-3-3-2-3-2\" data-name=\"feature three heading\">\n                        Built for business\n                    </h3>\n                    <p data-kid=\"1-3-3-2-3-3\" data-name=\"feature three text\">\n                        Owners get a property workspace, deal pipeline and AI-assisted admin tools.\n                    </p>\n                </article>\n            </div>\n        </section>\n        <div class=\"dark-panel\" data-kid=\"1-3-4\" data-name=\"dark panel container\" id=\"manager\">\n            <section class=\"section\" data-kid=\"1-3-4-1\" data-name=\"how it works section\">\n                <div class=\"section-head\" data-kid=\"1-3-4-1-1\" data-name=\"how it works header\">\n                    <div data-kid=\"1-3-4-1-1-1\" data-name=\"how it works copy\">\n                        <div class=\"eyebrow\" data-kid=\"1-3-4-1-1-1-1\" data-name=\"how it works eyebrow\">\n                            HOW IT WORKS\n                        </div>\n                        <h2 data-kid=\"1-3-4-1-1-1-2\" data-name=\"how it works heading\">\n                            Three moves.\n                            <br data-kid=\"1-3-4-1-1-1-2-1\" data-name=\"heading line break\"/>\n                            One smarter decision.\n                        </h2>\n                    </div>\n                </div>\n                <div class=\"steps\" data-kid=\"1-3-4-1-2\" data-name=\"steps grid\">\n                    <div data-kid=\"1-3-4-1-2-1\" data-name=\"step describe\">\n                        <b data-kid=\"1-3-4-1-2-1-1\" data-name=\"step describe label\">\n                            01\n                        </b>\n                        <h3 data-kid=\"1-3-4-1-2-1-2\" data-name=\"step describe heading\">\n                            Describe\n                        </h3>\n                        <p data-kid=\"1-3-4-1-2-1-3\" data-name=\"step describe text\">\n                            Enter the property’s structure, rooms, location and title.\n                        </p>\n                    </div>\n                    <div data-kid=\"1-3-4-1-2-2\" data-name=\"step predict\">\n                        <b data-kid=\"1-3-4-1-2-2-1\" data-name=\"step predict label\">\n                            02\n                        </b>\n                        <h3 data-kid=\"1-3-4-1-2-2-2\" data-name=\"step predict heading\">\n                            Predict\n                        </h3>\n                        <p data-kid=\"1-3-4-1-2-2-3\" data-name=\"step predict text\">\n                            Our model compares the property against learned Nigerian market patterns.\n                        </p>\n                    </div>\n                    <div data-kid=\"1-3-4-1-2-3\" data-name=\"step decide\">\n                        <b data-kid=\"1-3-4-1-2-3-1\" data-name=\"step decide label\">\n                            03\n                        </b>\n                        <h3 data-kid=\"1-3-4-1-2-3-2\" data-name=\"step decide heading\">\n                            Decide\n                        </h3>\n                        <p data-kid=\"1-3-4-1-2-3-3\" data-name=\"step decide text\">\n                            Use the estimate as a starting point for viewing, negotiation or valuation.\n                        </p>\n                    </div>\n                </div>\n            </section>\n        </div>\n        <section class=\"cta\" data-kid=\"1-3-5\" data-name=\"cta section\" id=\"start\">\n            <div data-kid=\"1-3-5-1\" data-name=\"cta section header\">\n                <div class=\"eyebrow\" data-kid=\"1-3-5-1-1\" data-name=\"cta eyebrow text\">\n                    READY WHEN YOU ARE\n                </div>\n                <h2 data-kid=\"1-3-5-1-2\" data-name=\"cta headline text\">\n                    Turn property data\n                    <br data-kid=\"1-3-5-1-2-1\" data-name=\"headline line break\"/>\n                    into a clearer number.\n                </h2>\n            </div>\n            <a class=\"hero-cta\" data-kid=\"1-3-5-2\" data-name=\"start estimating button\" href=\"#prediction\">\n                Start Estimating\n                <i aria-hidden=\"true\" data-kid=\"1-3-5-2-1\" data-lucide=\"arrow-up-right\" data-name=\"arrow up right icon\">\n                </i>\n            </a>\n        </section>\n        <footer data-kid=\"1-3-6\" data-name=\"footer bar\">\n            <span data-kid=\"1-3-6-1\" data-name=\"copyright text\">\n                © 2026 EstiMate\n            </span>\n            <span data-kid=\"1-3-6-2\" data-name=\"footer tagline\">\n                Decision support for the Nigerian property market.\n            </span>\n        </footer>\n    </main>\n</div>\n<script src=\"https://unpkg.com/lucide@latest\">\n</script>\n<script>\n    lucide.createIcons();\n</script>\n",
