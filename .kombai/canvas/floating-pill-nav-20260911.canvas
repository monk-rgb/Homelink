    "var_9534fbf345ce": {
      "type": "variant",
      "label": "Floating Pill Nav — Gold Halo",
      "parentId": null,
      "themeId": null,
      "rect": {
        "x": 2760,
        "y": 0,
        "w": 1280,
        "h": 800
      },
      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,600;9..144,700&family=Outfit:wght@300;400;500;600;700&display=swap');\n  :root{--ink:#0b0b0b;--soft:#141414;--gold:#deb631;--gold-hi:#f3d46a;--paper:#f7f9ff;--muted:#b8b8b8;--line:rgba(255,255,255,.12)}\n  body{margin:0;background:var(--ink);color:var(--paper);font-family:'Outfit',system-ui,sans-serif}\n  .gh-page{min-height:100vh;overflow:hidden;background:radial-gradient(900px 500px at 50% -12%,rgba(69,107,214,.28),transparent 64%),radial-gradient(540px 360px at 88% 1%,rgba(222,182,49,.16),transparent 65%),#0b0b0b;position:relative}\n  .gh-page:before{content:'';position:absolute;inset:0;pointer-events:none;opacity:.035;background-image:url(\"data:image/svg+xml,%3Csvg viewBox='0 0 180 180' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='.5'/%3E%3C/svg%3E\")}\n  .gh-nav-shell{position:fixed;z-index:30;top:16px;left:50%;transform:translateX(-50%);width:min(1120px,calc(100% - 32px));padding:1px;border-radius:999px;background:linear-gradient(110deg,rgba(255,255,255,.16),rgba(222,182,49,.34) 44%,rgba(89,147,255,.28) 78%,rgba(255,255,255,.12));box-shadow:0 18px 55px rgba(0,0,0,.46),0 0 38px rgba(62,122,255,.13),0 0 26px rgba(222,182,49,.09)}\n  .gh-nav{min-height:62px;display:flex;align-items:center;gap:28px;padding:8px 10px 8px 12px;border:1px solid rgba(255,255,255,.11);border-radius:999px;background:rgba(8,8,10,.94);backdrop-filter:blur(22px)}\n  .gh-brand{display:flex;align-items:center;gap:10px;flex:0 0 auto;color:#fff;font-size:17px;font-weight:700;letter-spacing:-.03em;white-space:nowrap}\n  .gh-mark{display:grid;place-items:center;width:36px;height:36px;border-radius:12px;color:#fff;font-family:'Fraunces',serif;font-size:19px;line-height:1;background:linear-gradient(145deg,#414149 0%,#151519 34%,#08080a 55%,#d1a72d 145%);border:1px solid rgba(255,255,255,.24);box-shadow:inset 1px 1px 4px rgba(255,255,255,.28),inset -4px -5px 9px rgba(0,0,0,.55),0 4px 10px rgba(0,0,0,.35)}\n  .gh-brand-ai{color:var(--gold-hi);font-weight:600}\n  .gh-links{display:flex;align-items:center;justify-content:center;gap:23px;min-width:0;flex:1}\n  .gh-links a{color:rgba(255,255,255,.67);font-size:13px;font-weight:400;letter-spacing:.01em;white-space:nowrap;transition:color .2s ease,opacity .2s ease}\n  .gh-links a:hover{color:#fff;opacity:1}\n  .gh-actions{display:flex;align-items:center;gap:10px;flex:0 0 auto}\n  .gh-theme{display:grid;place-items:center;width:30px;height:30px;border:0;color:rgba(255,255,255,.58);background:transparent;border-radius:50%;font-size:15px}\n  .gh-cta{display:inline-flex;align-items:center;justify-content:center;gap:8px;min-height:40px;padding:0 17px;border-radius:999px;background:#fff;color:#101014;font-size:13px;font-weight:700;letter-spacing:-.01em;box-shadow:0 3px 16px rgba(255,255,255,.16)}\n  .gh-cta svg{width:15px;height:15px;stroke-width:2.25}\n  .gh-main{position:relative;z-index:1;max-width:1180px;margin:0 auto;padding:154px 28px 0}\n  .gh-hero{display:grid;grid-template-columns:minmax(0,.9fr) minmax(420px,1.1fr);align-items:center;gap:72px;min-height:540px}\n  .gh-eyebrow{margin:0 0 17px;color:var(--gold);font-size:11px;font-weight:600;letter-spacing:.19em;text-transform:uppercase}\n  .gh-copy h1{margin:0;color:#f7f9ff;font-family:'Fraunces',serif;font-size:clamp(48px,5.8vw,78px);font-weight:600;line-height:.99;letter-spacing:-.065em}\n  .gh-copy h1 em{color:var(--gold-hi);font-style:italic;font-weight:500}\n  .gh-copy p{max-width:500px;margin:23px 0 0;color:#b9b9bd;font-size:16px;font-weight:300;line-height:1.65}\n  .gh-actions-row{display:flex;align-items:center;gap:20px;margin-top:31px}\n  .gh-primary{display:inline-flex;align-items:center;gap:9px;padding:14px 20px;border-radius:999px;background:var(--gold);color:#17130a;font-size:14px;font-weight:700;box-shadow:0 9px 30px rgba(222,182,49,.17)}\n  .gh-secondary{color:var(--gold-hi);font-size:14px;font-weight:600}\n  .gh-art{position:relative;height:428px;overflow:hidden;border:1px solid rgba(255,255,255,.14);border-radius:30px;background:#151515;box-shadow:0 30px 80px rgba(0,0,0,.34)}\n  .gh-art:after{content:'';position:absolute;inset:0;background:linear-gradient(135deg,rgba(255,255,255,.08),transparent 34%,rgba(222,182,49,.10));pointer-events:none}\n  .gh-photo{width:100%;height:100%;display:block;object-fit:cover;object-position:center;filter:saturate(.78) contrast(1.04) brightness(.75)}\n  .gh-arch{position:absolute;left:-16%;bottom:-35%;width:94%;height:82%;border:1px solid rgba(222,182,49,.58);border-radius:50% 50% 0 0/100% 100% 0 0;box-shadow:0 -18px 55px rgba(222,182,49,.14);transform:rotate(-11deg)}\n  .gh-estimate{position:absolute;right:22px;top:22px;z-index:2;display:flex;flex-direction:column;gap:5px;min-width:190px;padding:16px 18px;border:1px solid rgba(255,255,255,.18);border-radius:18px;background:rgba(7,7,8,.76);backdrop-filter:blur(16px);box-shadow:0 16px 35px rgba(0,0,0,.26)}\n  .gh-estimate span{color:var(--gold-hi);font-size:10px;font-weight:700;letter-spacing:.16em}\n  .gh-estimate strong{font-size:34px;line-height:1;font-weight:600;letter-spacing:-.05em}\n  .gh-estimate small{color:#bcbcc1;font-size:11px}\n  .gh-stats{display:grid;grid-template-columns:repeat(4,1fr);margin-top:72px;border-top:1px solid rgba(255,255,255,.14);border-bottom:1px solid rgba(255,255,255,.14)}\n  .gh-stat{display:flex;flex-direction:column;gap:5px;padding:22px 22px 24px;border-right:1px solid rgba(255,255,255,.11)}\n  .gh-stat:last-child{border-right:0}\n  .gh-stat strong{color:#fff;font-size:27px;font-weight:500;letter-spacing:-.05em}\n  .gh-stat span{color:#96969b;font-size:12px}\n  .gh-next{display:grid;grid-template-columns:1fr 1.3fr;gap:70px;padding:82px 0 102px}\n  .gh-next h2{margin:0;font-family:'Fraunces',serif;font-size:42px;font-weight:500;line-height:1.02;letter-spacing:-.06em}\n  .gh-next p{max-width:460px;margin:8px 0 0;color:#a8a8ad;font-size:15px;line-height:1.65}\n  .gh-features{display:grid;grid-template-columns:repeat(3,1fr);gap:1px;border:1px solid rgba(255,255,255,.12);background:rgba(255,255,255,.12)}\n  .gh-feature{padding:25px 24px 28px;background:#101010}\n  .gh-feature b{color:var(--gold);font-size:11px;letter-spacing:.12em}\n  .gh-feature h3{margin:16px 0 9px;font-size:19px;font-weight:500;letter-spacing:-.03em}\n  .gh-feature p{margin:0;color:#97979c;font-size:13px;line-height:1.5}\n  @media(max-width:820px){.gh-nav{gap:14px}.gh-links{gap:14px}.gh-links a{font-size:12px}.gh-main{padding-top:130px}.gh-hero{grid-template-columns:1fr;gap:42px}.gh-art{height:360px}.gh-next{grid-template-columns:1fr;gap:30px}}\n  @media(max-width:620px){.gh-nav-shell{top:12px;width:calc(100% - 24px)}.gh-nav{min-height:58px;padding:7px 8px 7px 10px;gap:0}.gh-brand{font-size:15px}.gh-mark{width:33px;height:33px;border-radius:11px;font-size:17px}.gh-links{display:none}.gh-actions{margin-left:auto;gap:6px}.gh-theme{display:none}.gh-cta{min-height:38px;padding:0 14px;font-size:12px}.gh-cta svg{width:14px;height:14px}.gh-main{padding:112px 18px 0}.gh-hero{min-height:0;gap:34px}.gh-copy h1{font-size:52px}.gh-copy p{font-size:15px}.gh-actions-row{flex-wrap:wrap;gap:16px}.gh-art{height:300px;border-radius:22px}.gh-estimate{right:14px;top:14px;min-width:165px;padding:13px 14px}.gh-estimate strong{font-size:29px}.gh-stats{grid-template-columns:repeat(2,1fr);margin-top:48px}.gh-stat:nth-child(2){border-right:0}.gh-stat:nth-child(-n+2){border-bottom:1px solid rgba(255,255,255,.11)}.gh-next{padding:62px 0 72px}.gh-next h2{font-size:36px}.gh-features{grid-template-columns:1fr}.gh-feature{padding:20px}}\n</style>\n<script src=\"https://unpkg.com/lucide@latest\">\n</script>\n<div class=\"gh-page\" data-kid=\"1\">\n    <div aria-label=\"Floating primary navigation\" class=\"gh-nav-shell\" data-kid=\"1-1\">\n        <header class=\"gh-nav\" data-kid=\"1-1-1\">\n            <a aria-label=\"EstiMate home\" class=\"gh-brand\" data-kid=\"1-1-1-1\" href=\"#\">\n                <span class=\"gh-mark\" data-kid=\"1-1-1-1-1\">\n                    E\n                </span>\n                <span data-kid=\"1-1-1-1-2\">\n                    EstiMate\n                    <span class=\"gh-brand-ai\" data-kid=\"1-1-1-1-2-1\">\n                        AI\n                    </span>\n                </span>\n            </a>\n            <nav aria-label=\"Primary navigation\" class=\"gh-links\" data-kid=\"1-1-1-2\">\n                <a data-kid=\"1-1-1-2-1\" href=\"#prediction\">\n                    Prediction\n                </a>\n                <a data-kid=\"1-1-1-2-2\" href=\"#propkonet\">\n                    PropkoNet\n                </a>\n                <a data-kid=\"1-1-1-2-3\" href=\"#about\">\n                    About\n                </a>\n                <a data-kid=\"1-1-1-2-4\" href=\"#manager\">\n                    Manager\n                </a>\n            </nav>\n            <div class=\"gh-actions\" data-kid=\"1-1-1-3\">\n                <span aria-label=\"Theme mode\" class=\"gh-theme\" data-kid=\"1-1-1-3-1\">\n                    <i data-kid=\"1-1-1-3-1-1\" data-lucide=\"sun-medium\">\n                    </i>\n                </span>\n                <a class=\"gh-cta\" data-kid=\"1-1-1-3-2\" href=\"#get-started\">\n                    Get Started\n                    <i data-kid=\"1-1-1-3-2-1\" data-lucide=\"house\">\n                    </i>\n                </a>\n            </div>\n        </header>\n    </div>\n    <main class=\"gh-main\" data-kid=\"1-2\">\n        <section aria-label=\"Property intelligence introduction\" class=\"gh-hero\" data-kid=\"1-2-1\">\n            <div class=\"gh-copy\" data-kid=\"1-2-1-1\">\n                <p class=\"gh-eyebrow\" data-kid=\"1-2-1-1-1\">\n                    Clearer Estimates\n                </p>\n                <h1 data-kid=\"1-2-1-1-2\">\n                    Nigerian\n                    <br data-kid=\"1-2-1-1-2-1\"/>\n                    <em data-kid=\"1-2-1-1-2-2\">\n                        Real estate Intelligence\n                    </em>\n                </h1>\n                <p data-kid=\"1-2-1-1-3\">\n                    Compare the details of a Nigerian property against the model's market patterns before you arrange a viewing, make an offer, or brief a valuer.\n                </p>\n                <div class=\"gh-actions-row\" data-kid=\"1-2-1-1-4\">\n                    <a class=\"gh-primary\" data-kid=\"1-2-1-1-4-1\" href=\"#estimate\">\n                        Estimate a property\n                        <span aria-hidden=\"true\" data-kid=\"1-2-1-1-4-1-1\">\n                            →\n                        </span>\n                    </a>\n                    <a class=\"gh-secondary\" data-kid=\"1-2-1-1-4-2\" href=\"#photo\">\n                        Review a property photo\n                    </a>\n                </div>\n            </div>\n            <div class=\"gh-art\" data-kid=\"1-2-1-2\">\n                <img alt=\"Modern terraced duplex exterior\" class=\"gh-photo\" data-kid=\"1-2-1-2-1\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/static/uploads/a9ef982aca674ff493ff629c98b517e4.jpg\"/>\n                <div aria-hidden=\"true\" class=\"gh-arch\" data-kid=\"1-2-1-2-2\">\n                </div>\n                <div class=\"gh-estimate\" data-kid=\"1-2-1-2-3\">\n                    <span data-kid=\"1-2-1-2-3-1\">\n                        AI ESTIMATE\n                    </span>\n                    <strong data-kid=\"1-2-1-2-3-2\" data-name=\"ai estimate value\">\n                        ₦200M\n                    </strong>\n                    <small data-kid=\"1-2-1-2-3-3\" data-name=\"confidence range text\">\n                        Confidence range · ₦195M — ₦215M\n                    </small>\n                </div>\n            </div>\n        </section>\n        <section aria-label=\"Estimation workflow\" class=\"gh-stats\" data-kid=\"1-2-2\">\n            <div class=\"gh-stat\" data-kid=\"1-2-2-1\">\n                <strong data-kid=\"1-2-2-1-1\" data-name=\"step 01 counter\">\n                    01\n                </strong>\n                <span data-kid=\"1-2-2-1-2\">\n                    Enter property details\n                </span>\n            </div>\n            <div class=\"gh-stat\" data-kid=\"1-2-2-2\">\n                <strong data-kid=\"1-2-2-2-1\" data-name=\"step 02 counter\">\n                    02\n                </strong>\n                <span data-kid=\"1-2-2-2-2\">\n                    Review the estimate range\n                </span>\n            </div>\n            <div class=\"gh-stat\" data-kid=\"1-2-2-3\">\n                <strong data-kid=\"1-2-2-3-1\" data-name=\"step 03 counter\">\n                    03\n                </strong>\n                <span data-kid=\"1-2-2-3-2\">\n                    Save property work in one place\n                </span>\n            </div>\n            <div class=\"gh-stat\" data-kid=\"1-2-2-4\">\n                <strong data-kid=\"1-2-2-4-1\" data-name=\"currency code label\">\n                    NGN\n                </strong>\n                <span data-kid=\"1-2-2-4-2\">\n                    Prices shown in naira\n                </span>\n            </div>\n        </section>\n        <section class=\"gh-next\" data-kid=\"1-2-3\">\n            <div data-kid=\"1-2-3-1\">\n                <p class=\"gh-eyebrow\" data-kid=\"1-2-3-1-1\">\n                    A PRACTICAL STARTING POINT\n                </p>\n                <h2 data-kid=\"1-2-3-1-2\">\n                    Make the next\n                    <br data-kid=\"1-2-3-1-2-1\"/>\n                    property decision easier.\n                </h2>\n            </div>\n            <div class=\"gh-features\" data-kid=\"1-2-3-2\">\n                <article class=\"gh-feature\" data-kid=\"1-2-3-2-1\">\n                    <b data-kid=\"1-2-3-2-1-1\" data-name=\"feature 01 step number\">\n                        01\n                    </b>\n                    <h3 data-kid=\"1-2-3-2-1-2\">\n                        Data-led\n                    </h3>\n                    <p data-kid=\"1-2-3-2-1-3\">\n                        Predictions learn patterns from Nigerian property records instead of relying on a generic global model.\n                    </p>\n                </article>\n                <article class=\"gh-feature\" data-kid=\"1-2-3-2-2\">\n                    <b data-kid=\"1-2-3-2-2-1\" data-name=\"feature 02 step number\">\n                        02\n                    </b>\n                    <h3 data-kid=\"1-2-3-2-2-2\">\n                        Photo review\n                    </h3>\n                    <p data-kid=\"1-2-3-2-2-3\">\n                        Upload a property image to record visible finish, layout cues and likely property type.\n                    </p>\n                </article>\n                <article class=\"gh-feature\" data-kid=\"1-2-3-2-3\">\n                    <b data-kid=\"1-2-3-2-3-1\" data-name=\"feature 03 step number\">\n                        03\n                    </b>\n                    <h3 data-kid=\"1-2-3-2-3-2\">\n                        Built for business\n                    </h3>\n                    <p data-kid=\"1-2-3-2-3-3\">\n                        Owners get a property workspace, deal pipeline and AI-assisted admin tools.\n                    </p>\n                </article>\n            </div>\n        </section>\n    </main>\n</div>\n<script>\n    lucide.createIcons({attrs:{'stroke-width':2}});\n</script>\n",
