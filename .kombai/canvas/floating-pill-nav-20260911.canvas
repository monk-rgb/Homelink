      "html": "<div class=\"aurora-page min-h-screen overflow-hidden bg-[#09090b] text-[#f8f8f4]\" data-kid=\"1\" data-name=\"aurora page layout container\" style=\"font-family:Outfit, ui-sans-serif, system-ui, sans-serif;\">\n    <style>\n        @import url('https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,600;9..144,700&family=Outfit:wght@300;400;500;600;700&display=swap');\n    .aurora-page{position:relative;isolation:isolate;background-image:radial-gradient(circle at 14% 4%,rgba(104,42,127,.42),transparent 30%),radial-gradient(circle at 86% 14%,rgba(31,85,177,.4),transparent 31%),radial-gradient(circle at 55% 44%,rgba(198,144,46,.12),transparent 24%),linear-gradient(180deg,#121019 0%,#09090b 42%,#0b0b0d 100%)}\n    .aurora-page:before{content:\"\";position:absolute;inset:0;z-index:-1;pointer-events:none;background-image:linear-gradient(rgba(255,255,255,.018) 1px,transparent 1px),linear-gradient(90deg,rgba(255,255,255,.018) 1px,transparent 1px);background-size:72px 72px;mask-image:linear-gradient(to bottom,rgba(0,0,0,.7),transparent 74%)}\n    .aurora-page:after{content:\"\";position:absolute;z-index:-1;top:0;left:50%;width:860px;height:360px;transform:translateX(-50%);border-radius:999px;background:rgba(213,157,66,.08);filter:blur(86px);pointer-events:none}\n    .pill-nav{position:relative;z-index:10;width:min(930px,calc(100% - 32px));min-height:62px;margin:16px auto 0;padding:8px 10px 8px 17px;display:flex;align-items:center;gap:12px;border:1px solid rgba(255,255,255,.14);border-radius:999px;background:linear-gradient(110deg,rgba(23,23,26,.98),rgba(9,9,11,.985) 55%,rgba(25,22,28,.98));box-shadow:0 20px 55px rgba(0,0,0,.38),0 0 0 1px rgba(255,255,255,.035) inset,0 0 30px rgba(117,62,163,.16);backdrop-filter:blur(22px)}\n    .pill-nav:before{content:\"\";position:absolute;inset:1px;border-radius:inherit;pointer-events:none;background:linear-gradient(105deg,rgba(255,255,255,.095),transparent 27%,transparent 72%,rgba(226,185,101,.06));mask-image:linear-gradient(#000,#000)}\n    .brand-zone{display:flex;align-items:center;gap:10px;min-width:182px;position:relative;z-index:1}\n    .app-mark{position:relative;display:grid;place-items:center;width:38px;height:38px;flex:none;border:1px solid rgba(255,232,165,.75);border-radius:13px;color:#1b1510;font-family:Fraunces,serif;font-size:21px;font-weight:700;background:linear-gradient(145deg,#fff2bb 0%,#edc968 27%,#a97022 63%,#f6d77c 100%);box-shadow:inset 2px 2px 4px rgba(255,255,255,.72),inset -4px -5px 7px rgba(60,28,4,.3),0 5px 13px rgba(232,180,64,.22);transform:perspective(100px) rotateX(4deg)}\n    .app-mark:after{content:\"\";position:absolute;top:4px;left:7px;width:15px;height:7px;border-radius:999px;background:rgba(255,255,255,.55);filter:blur(1px);transform:rotate(-25deg)}\n    .brand-name{color:#fff;letter-spacing:-.035em;font-size:16px;font-weight:700;white-space:nowrap}.brand-name em{font-style:normal;color:#e6c66d;font-weight:500}\n    .link-zone{display:flex;align-items:center;justify-content:center;gap:25px;flex:1;min-width:0;position:relative;z-index:1}.nav-link{color:rgba(255,255,255,.65);font-size:12px;font-weight:400;letter-spacing:.01em;white-space:nowrap;transition:color .2s ease,opacity .2s ease}.nav-link:hover{color:#fff;opacity:1}.nav-link.active{color:rgba(255,255,255,.9)}\n    .action-zone{display:flex;align-items:center;gap:8px;position:relative;z-index:1}.cta-pill{display:inline-flex;align-items:center;gap:8px;height:42px;padding:0 16px 0 15px;border-radius:999px;background:#fff;color:#111216;font-size:12px;font-weight:700;white-space:nowrap;box-shadow:0 5px 16px rgba(255,255,255,.13),inset 0 -2px 3px rgba(0,0,0,.11);transition:transform .2s ease,box-shadow .2s ease}.cta-pill:hover{transform:translateY(-1px);box-shadow:0 8px 20px rgba(255,255,255,.19),inset 0 -2px 3px rgba(0,0,0,.11)}.cta-pill i{width:14px;height:14px;stroke-width:2.5}.theme-dot{display:grid;place-items:center;width:34px;height:34px;border:1px solid rgba(255,255,255,.12);border-radius:50%;color:rgba(255,255,255,.58);background:rgba(255,255,255,.035)}.theme-dot i{width:15px;height:15px;stroke-width:1.7}\n    .hero-shell{width:min(1110px,calc(100% - 64px));margin:76px auto 0;display:grid;grid-template-columns:minmax(0,.91fr) minmax(430px,1.09fr);align-items:center;gap:70px}.eyebrow{color:#d8b65b;font-size:10px;font-weight:600;letter-spacing:.18em;text-transform:uppercase}.hero-title{margin:17px 0 20px;color:#fbfaf7;font-family:Fraunces,Georgia,serif;font-size:clamp(52px,6vw,82px);font-weight:600;letter-spacing:-.065em;line-height:.98}.hero-title em{color:#ddc079;font-style:italic;font-weight:500}.hero-copy{max-width:460px;color:#a9a5ac;font-size:15px;font-weight:300;line-height:1.7}.hero-actions{display:flex;align-items:center;gap:22px;margin-top:30px}.hero-button{display:inline-flex;align-items:center;gap:10px;border-radius:999px;padding:13px 18px;color:#17130b;background:#d8b35b;font-size:13px;font-weight:700;box-shadow:0 12px 28px rgba(216,179,91,.17)}.hero-button i{width:15px;height:15px}.hero-secondary{color:#e2c977;font-size:13px;font-weight:500}.hero-art{position:relative;height:478px;overflow:hidden;border:1px solid rgba(255,255,255,.11);border-radius:28px;background:#17161a;box-shadow:0 25px 60px rgba(0,0,0,.36)}.hero-art:before{content:\"\";position:absolute;inset:0;z-index:1;background:linear-gradient(180deg,rgba(5,5,6,.02) 30%,rgba(7,7,8,.68) 100%)}.terraced-photo{width:100%;height:100%;object-fit:cover;opacity:.84;filter:saturate(.8) contrast(1.03)}.arch{position:absolute;z-index:2;left:12%;bottom:-8%;width:76%;height:64%;border:1px solid rgba(244,213,141,.4);border-bottom:0;border-radius:50% 50% 0 0/45% 45% 0 0;box-shadow:0 0 0 1px rgba(255,255,255,.06) inset,0 0 70px rgba(198,146,51,.11)}.estimate-float{position:absolute;z-index:3;right:24px;top:24px;width:185px;padding:16px 17px;border:1px solid rgba(255,255,255,.18);border-radius:16px;background:rgba(13,13,15,.69);backdrop-filter:blur(16px);box-shadow:0 16px 35px rgba(0,0,0,.24)}.estimate-float span{display:block;color:#e6c879;font-size:9px;font-weight:600;letter-spacing:.16em}.estimate-float strong{display:block;margin:5px 0 2px;color:#fff;font-family:Fraunces,serif;font-size:29px;letter-spacing:-.04em}.estimate-float small{color:#d1d0cb;font-size:10px;line-height:1.45}\n    .stats-strip{width:min(1110px,calc(100% - 64px));margin:52px auto 0;display:grid;grid-template-columns:repeat(4,1fr);border-top:1px solid rgba(255,255,255,.14);border-bottom:1px solid rgba(255,255,255,.14)}.stat{display:flex;align-items:center;gap:14px;padding:18px 16px}.stat+ .stat{border-left:1px solid rgba(255,255,255,.12)}.stat strong{color:#d9b85f;font-family:Fraunces,serif;font-size:20px;font-weight:600}.stat span{color:#8c8990;font-size:11px;line-height:1.35}\n    .feature-shell{width:min(1110px,calc(100% - 64px));margin:74px auto 100px}.feature-head{display:flex;align-items:end;justify-content:space-between;gap:30px;margin-bottom:28px}.feature-head h2{margin:10px 0 0;color:#f4f1e9;font-family:Fraunces,serif;font-size:40px;font-weight:600;letter-spacing:-.045em;line-height:1.05}.feature-head p{max-width:330px;color:#8d8990;font-size:13px;line-height:1.6}.feature-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:1px;overflow:hidden;border:1px solid rgba(255,255,255,.1);border-radius:18px;background:rgba(255,255,255,.1)}.feature-card{min-height:175px;padding:25px 24px;background:rgba(18,18,20,.9)}.feature-card span{color:#d8b65b;font-size:10px;font-weight:600;letter-spacing:.14em}.feature-card h3{margin:10px 0 7px;color:#f7f6f2;font-family:Fraunces,serif;font-size:23px;font-weight:600}.feature-card p{margin:0;color:#929097;font-size:12px;line-height:1.6}\n    @media(max-width:850px){.pill-nav{width:calc(100% - 32px)}.brand-zone{min-width:auto}.link-zone{gap:14px}.hero-shell{grid-template-columns:1fr;gap:34px;margin-top:62px}.hero-copy{max-width:620px}.hero-art{height:390px}.stats-strip{margin-top:38px}.feature-head{align-items:start;flex-direction:column;gap:5px}}\n    @media(max-width:650px){.pill-nav{min-height:58px;padding:7px 8px 7px 12px;gap:8px}.app-mark{width:34px;height:34px;border-radius:11px;font-size:18px}.brand-name{font-size:14px}.link-zone{display:none}.action-zone{margin-left:auto}.cta-pill{height:38px;padding:0 13px;font-size:11px}.theme-dot{width:30px;height:30px}.hero-shell,.stats-strip,.feature-shell{width:calc(100% - 32px)}.hero-shell{margin-top:56px}.hero-title{font-size:48px}.hero-art{height:330px;border-radius:21px}.stats-strip{grid-template-columns:1fr 1fr}.stat{padding:14px 10px}.stat+ .stat{border-left:0}.stat:nth-child(n+3){border-top:1px solid rgba(255,255,255,.12)}.feature-shell{margin-top:60px}.feature-grid{grid-template-columns:1fr}.feature-card{min-height:0}.feature-head h2{font-size:34px}}\n    </style>\n    <header aria-label=\"Primary navigation\" class=\"pill-nav\" data-kid=\"1-1\" data-name=\"primary navigation header\">\n        <a aria-label=\"EstiMate home\" class=\"brand-zone\" data-kid=\"1-1-1\" data-name=\"brand identity logo link\" href=\"#\">\n            <span aria-hidden=\"true\" class=\"app-mark\" data-kid=\"1-1-1-1\" data-name=\"app mark icon\">\n                E\n            </span>\n            <span class=\"brand-name\" data-kid=\"1-1-1-2\" data-name=\"brand name text\">\n                EstiMate\n                <em data-kid=\"1-1-1-2-1\" data-name=\"brand name emphasis text\">\n                    AI\n                </em>\n            </span>\n        </a>\n        <nav aria-label=\"Product links\" class=\"link-zone\" data-kid=\"1-1-2\" data-name=\"navigation links container\">\n            <a class=\"nav-link active\" data-kid=\"1-1-2-1\" data-name=\"prediction link\" href=\"#prediction\">\n                Prediction\n            </a>\n            <a class=\"nav-link\" data-kid=\"1-1-2-2\" data-name=\"propkonet link\" href=\"#propkonet\">\n                PropkoNet\n            </a>\n            <a class=\"nav-link\" data-kid=\"1-1-2-3\" data-name=\"about link\" href=\"#about\">\n                About\n            </a>\n            <a class=\"nav-link\" data-kid=\"1-1-2-4\" data-name=\"manager link\" href=\"#manager\">\n                Manager\n            </a>\n        </nav>\n        <div class=\"action-zone\" data-kid=\"1-1-3\" data-name=\"action items container\">\n            <a class=\"cta-pill\" data-kid=\"1-1-3-1\" data-name=\"get started call to action\" href=\"#get-started\">\n                <i aria-hidden=\"true\" data-kid=\"1-1-3-1-1\" data-lucide=\"house\" data-name=\"house icon\">\n                </i>\n                <span data-kid=\"1-1-3-1-2\" data-name=\"get started button label\">\n                    Get Started\n                </span>\n            </a>\n            <button aria-label=\"Theme mode\" class=\"theme-dot\" data-kid=\"1-1-3-2\" data-name=\"theme mode toggle button\" type=\"button\">\n                <i aria-hidden=\"true\" data-kid=\"1-1-3-2-1\" data-lucide=\"sun\" data-name=\"sun icon\">\n                </i>\n            </button>\n        </div>\n    </header>\n    <main data-kid=\"1-2\" data-name=\"main content area\">\n        <section class=\"hero-shell\" data-kid=\"1-2-1\" data-name=\"hero section\" id=\"prediction\">\n            <div class=\"hero-copy-wrap\" data-kid=\"1-2-1-1\" data-name=\"hero content wrapper\">\n                <div class=\"eyebrow\" data-kid=\"1-2-1-1-1\" data-name=\"hero eyebrow label\">\n                    Clearer Estimates\n                </div>\n                <h1 class=\"hero-title\" data-kid=\"1-2-1-1-2\" data-name=\"hero title text\">\n                    Nigerian\n                    <br data-kid=\"1-2-1-1-2-1\" data-name=\"title line break\"/>\n                    <em data-kid=\"1-2-1-1-2-2\" data-name=\"hero title emphasis\">\n                        Real estate Intelligence\n                    </em>\n                </h1>\n                <p class=\"hero-copy\" data-kid=\"1-2-1-1-3\" data-name=\"hero description paragraph\">\n                    Compare the details of a Nigerian property against the model's market patterns before you arrange a viewing, make an offer, or brief a valuer.\n                </p>\n                <div class=\"hero-actions\" data-kid=\"1-2-1-1-4\" data-name=\"hero actions container\">\n                    <a class=\"hero-button\" data-kid=\"1-2-1-1-4-1\" data-name=\"estimate property button\" href=\"#get-started\">\n                        Estimate a property\n                        <i aria-hidden=\"true\" data-kid=\"1-2-1-1-4-1-1\" data-lucide=\"arrow-up-right\" data-name=\"arrow up right icon\">\n                        </i>\n                    </a>\n                    <a class=\"hero-secondary\" data-kid=\"1-2-1-1-4-2\" data-name=\"review photo link\" href=\"#photo-review\">\n                        Review a property photo\n                    </a>\n                </div>\n            </div>\n            <div class=\"hero-art\" data-kid=\"1-2-1-2\" data-name=\"hero visual art section\" id=\"about\">\n                <img alt=\"Modern terraced duplex exterior\" class=\"terraced-photo\" data-kid=\"1-2-1-2-1\" data-name=\"terraced duplex image\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/static/uploads/a9ef982aca674ff493ff629c98b517e4.jpg\"/>\n                <div aria-hidden=\"true\" class=\"arch\" data-kid=\"1-2-1-2-2\" data-name=\"decorative arch\">\n                </div>\n                <div class=\"estimate-float\" data-kid=\"1-2-1-2-3\" data-name=\"ai estimate float card\">\n                    <span data-kid=\"1-2-1-2-3-1\" data-name=\"ai estimate label\">\n                        AI ESTIMATE\n                    </span>\n                    <strong data-kid=\"1-2-1-2-3-2\" data-name=\"ai estimate value text\">\n                        ₦200M\n                    </strong>\n                    <small data-kid=\"1-2-1-2-3-3\" data-name=\"estimate confidence range text\">\n                        Confidence range · ₦195M — ₦215M\n                    </small>\n                </div>\n            </div>\n        </section>\n        <section aria-label=\"Estimation workflow\" class=\"stats-strip\" data-kid=\"1-2-2\" data-name=\"estimation workflow stats strip\">\n            <div class=\"stat\" data-kid=\"1-2-2-1\" data-name=\"step one stat card\">\n                <strong data-kid=\"1-2-2-1-1\" data-name=\"step one number\">\n                    01\n                </strong>\n                <span data-kid=\"1-2-2-1-2\" data-name=\"step one label\">\n                    Enter property details\n                </span>\n            </div>\n            <div class=\"stat\" data-kid=\"1-2-2-2\" data-name=\"step two stat card\">\n                <strong data-kid=\"1-2-2-2-1\" data-name=\"step two number\">\n                    02\n                </strong>\n                <span data-kid=\"1-2-2-2-2\" data-name=\"step two label\">\n                    Review the estimate range\n                </span>\n            </div>\n            <div class=\"stat\" data-kid=\"1-2-2-3\" data-name=\"step three stat card\">\n                <strong data-kid=\"1-2-2-3-1\" data-name=\"step three number\">\n                    03\n                </strong>\n                <span data-kid=\"1-2-2-3-2\" data-name=\"step three label\">\n                    Save property work in one place\n                </span>\n            </div>\n            <div class=\"stat\" data-kid=\"1-2-2-4\" data-name=\"currency stat card\">\n                <strong data-kid=\"1-2-2-4-1\" data-name=\"currency code\">\n                    NGN\n                </strong>\n                <span data-kid=\"1-2-2-4-2\" data-name=\"currency label\">\n                    Prices shown in naira\n                </span>\n            </div>\n        </section>\n        <section class=\"feature-shell\" data-kid=\"1-2-3\" data-name=\"features section\" id=\"manager\">\n            <div class=\"feature-head\" data-kid=\"1-2-3-1\" data-name=\"features section header\">\n                <div data-kid=\"1-2-3-1-1\" data-name=\"features header content\">\n                    <div class=\"eyebrow\" data-kid=\"1-2-3-1-1-1\" data-name=\"features eyebrow label\">\n                        A PRACTICAL STARTING POINT\n                    </div>\n                    <h2 data-kid=\"1-2-3-1-1-2\" data-name=\"features title text\">\n                        Make the next\n                        <br data-kid=\"1-2-3-1-1-2-1\" data-name=\"title line break\"/>\n                        property decision easier.\n                    </h2>\n                </div>\n                <p data-kid=\"1-2-3-1-2\" data-name=\"features description paragraph\">\n                    Built for buyers, sellers, agents and investors who want a sharper first estimate before a human valuation.\n                </p>\n            </div>\n            <div class=\"feature-grid\" data-kid=\"1-2-3-2\" data-name=\"features grid container\">\n                <article class=\"feature-card\" data-kid=\"1-2-3-2-1\" data-name=\"data led feature card\">\n                    <span data-kid=\"1-2-3-2-1-1\" data-name=\"data led step number\">\n                        01\n                    </span>\n                    <h3 data-kid=\"1-2-3-2-1-2\" data-name=\"data led feature title\">\n                        Data-led\n                    </h3>\n                    <p data-kid=\"1-2-3-2-1-3\" data-name=\"data led feature description\">\n                        Predictions learn patterns from Nigerian property records instead of relying on a generic global model.\n                    </p>\n                </article>\n                <article class=\"feature-card\" data-kid=\"1-2-3-2-2\" data-name=\"photo review feature card\">\n                    <span data-kid=\"1-2-3-2-2-1\" data-name=\"photo review step number\">\n                        02\n                    </span>\n                    <h3 data-kid=\"1-2-3-2-2-2\" data-name=\"photo review feature title\">\n                        Photo review\n                    </h3>\n                    <p data-kid=\"1-2-3-2-2-3\" data-name=\"photo review feature description\">\n                        Upload a property image to record visible finish, layout cues and likely property type alongside your own research.\n                    </p>\n                </article>\n                <article class=\"feature-card\" data-kid=\"1-2-3-2-3\" data-name=\"business feature card\">\n                    <span data-kid=\"1-2-3-2-3-1\" data-name=\"business feature step number\">\n                        03\n                    </span>\n                    <h3 data-kid=\"1-2-3-2-3-2\" data-name=\"business feature title\">\n                        Built for business\n                    </h3>\n                    <p data-kid=\"1-2-3-2-3-3\" data-name=\"business feature description\">\n                        Owners get a property workspace, deal pipeline and AI-assisted admin tools.\n                    </p>\n                </article>\n            </div>\n        </section>\n    </main>\n    <script src=\"https://unpkg.com/lucide@latest\">\n    </script>\n    <script>\n        lucide.createIcons();\n    </script>\n</div>\n",
