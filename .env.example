# Add your OpenAI API key locally. Never commit the real key.
OPENAI_API_KEY=
OPENAI_VISION_MODEL=gpt-4o-mini
OPENAI_TEXT_MODEL=gpt-4o-mini
SERPAPI_KEY=
FLASK_SECRET_KEY=replace-with-a-random-secret
# Admin authentication (JWT issued as an HttpOnly cookie)
# Use a long random string, e.g. `python -c "import secrets;print(secrets.token_urlsafe(48))"`
ADMIN_JWT_SECRET=replace-with-a-long-random-secret
ADMIN_JWT_TTL_SECONDS=28800
# Set to 1 to mark the admin cookie Secure (required when serving over HTTPS)
ADMIN_COOKIE_SECURE=0
# Optional bootstrap admin. Created/updated on startup; the legacy ADMIN_PASSWORD
# is still accepted for the first login so existing deployments keep working.
ADMIN_EMAIL=admin@estimate.ng
ADMIN_PASSWORD=replace-with-a-strong-admin-password
# ---------------------------------------------------------------------------
# Paystack property payments
# ---------------------------------------------------------------------------
# The SECRET key is used server-side only. Never expose it to the browser and
# never commit a real key. Get both keys from Paystack Dashboard > Settings > API Keys.
PAYSTACK_SECRET_KEY=
# The PUBLIC key may be shared with the frontend (inline checkout) and is safe to expose.
PAYSTACK_PUBLIC_KEY=
# Paystack signs webhooks with your account secret key. Leave blank to reuse
# PAYSTACK_SECRET_KEY, or set it if Paystack gives you a dedicated webhook secret.
PAYSTACK_WEBHOOK_SECRET=
# Public HTTPS base URL of this app, used to build the Paystack callback URL.
# Leave blank in local development to fall back to the request host.
PAYSTACK_CALLBACK_BASE_URL=
# Also set the Webhook URL in the Paystack dashboard to:
#   https://<your-domain>/webhooks/paystack
# Currency (NGN by default).
PAYSTACK_CURRENCY=NGN
# How long the platform holds funds before paying the seller, in hours.
PAYOUT_HOLD_HOURS=24
# Maximum automatic retries for a failed payout transfer.
PAYOUT_MAX_RETRIES=3
# Shared secret required by POST /internal/payouts/run (the payout worker).
# Generate with: python -c "import secrets;print(secrets.token_urlsafe(48))"
PAYOUT_CRON_SECRET=replace-with-a-long-random-secret
# ---------------------------------------------------------------------------
# Storage location for the SQLite database and private verification uploads.
# Leave blank locally. On a host with a persistent disk mounted (e.g. Render
# Starter + a disk at /var/data) set it to that mount path, otherwise the
# filesystem is reset on every deploy and the database is wiped.
# NOTE: Render's FREE plan has no persistent disks - data will be lost on
# redeploy even when this is set. See README for the free-tier options.
ESTIMATE_DATA_DIR=
# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Leave blank to use the local SQLite file (estimate.db) - fine for development.
# On a managed host the local file is wiped on every deploy, so set this to a
# hosted Postgres URL to keep users, listings and payments permanently:
#   Neon:     postgresql://user:pass@ep-xxx.eu-central-1.aws.neon.tech/dbname?sslmode=require
#   Supabase: postgresql://postgres:pass@db.xxx.supabase.co:5432/postgres
DATABASE_URL=
# ---------------------------------------------------------------------------
# File storage (listing photos and verification documents)
# ---------------------------------------------------------------------------
# Leave blank to store files on the local disk. On a free host that disk is
# wiped on every deploy, so configure S3-compatible object storage to keep them.
# Works with Cloudflare R2, Supabase Storage, Backblaze B2 or AWS S3.
S3_BUCKET=
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto
# Public URL prefix used to build image links, e.g. https://cdn.example.com
# (an R2 public bucket domain or custom domain). If blank, time-limited signed
# URLs are generated instead.
S3_PUBLIC_BASE_URL=
S3_PUBLIC_PREFIX=uploads
S3_PRIVATE_PREFIX=verification_uploads
